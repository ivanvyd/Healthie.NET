<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Healthie.NET.Coravel</PackageId>
    <Description>Coravel scheduling provider for Healthie.NET: runs pulse checks on Coravel's scheduler, so an application already using Coravel keeps one scheduler rather than two.</Description>
    <PackageTags>$(HealthieCommonTags);coravel;scheduling</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Healthie.Tests.Unit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Coravel" />
    <PackageReference Include="Cronos" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Healthie.Abstractions\Healthie.Abstractions.csproj" />
  </ItemGroup>

</Project>
