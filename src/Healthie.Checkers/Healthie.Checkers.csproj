<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Healthie.NET.Checkers</PackageId>
    <Description>Ready-made pulse checkers for Healthie.NET: HTTP endpoints, TCP ports, TLS certificate expiry, DNS resolution and disk space, with no checker code to write.</Description>
    <PackageTags>$(HealthieCommonTags);http;tcp;dns;tls;certificate;disk</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Healthie.Tests.Unit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Healthie.Abstractions\Healthie.Abstractions.csproj" />
  </ItemGroup>

</Project>
