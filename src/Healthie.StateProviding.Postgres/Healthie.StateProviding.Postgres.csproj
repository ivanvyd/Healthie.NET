<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Healthie.NET.Postgres</PackageId>
    <Description>PostgreSQL state provider for Healthie.NET -- persists pulse checker state to PostgreSQL, including Databricks Lakebase and any other PostgreSQL-compatible service.</Description>
    <PackageTags>$(HealthieCommonTags);postgres;postgresql;npgsql;lakebase</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Healthie.StateProviding.Relational\Healthie.StateProviding.Relational.csproj" />
  </ItemGroup>

</Project>
